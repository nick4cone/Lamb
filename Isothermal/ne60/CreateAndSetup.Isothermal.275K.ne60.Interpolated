#!/bin/sh
CASENAME=CAM_6_4_025_20240829_SEne60_L30_400m_fadiab_lamb_isothermal_275K_Interp

~/CAM_6_4_025_20240829/cime/scripts/create_newcase --compset FADIAB --res ne60_ne60_mg16 --pecount 128 --case ~/CAM_6_4_025_20240829_cases/$CASENAME --run-unsupported --project UMIC0104
cd ~/CAM_6_4_025_20240829_cases/$CASENAME

./xmlchange DEBUG=FALSE
./xmlchange DOUT_S=FALSE
./xmlchange STOP_OPTION=ndays,STOP_N=3
./xmlquery CAM_CONFIG_OPTS
./xmlchange --file env_build.xml --id CAM_CONFIG_OPTS --val "--phys adiabatic --analytic_ic"
./xmlquery CAM_CONFIG_OPTS
./xmlchange JOB_WALLCLOCK_TIME=02:00:00
./pelayout
./case.setup
